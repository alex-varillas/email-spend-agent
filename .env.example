# Gmail API (OAuth2). Client id/secret vienen de Google Cloud Console.
# El refresh token se obtiene corriendo: npm run authorize-gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# OpenAI (extracción estructurada por LLM, Structured Outputs). API key de
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram (entrega del resumen y bot conversacional). Bot creado con BotFather.
TELEGRAM_BOT_TOKEN=
# Obligatoria: es el único chat al que responde el bot (tu id numérico).
TELEGRAM_CHAT_ID=

# Groq (interpretación de mensajes del bot conversacional — bajo volumen,
# el tier gratuito alcanza de sobra). API key de https://console.groq.com
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Flujo web multiusuario: heredado, inactivo y sin soporte. Para uso personal
# dejar estas tres variables vacías. Requeriría un OAuth client tipo "Web
# application" (distinto al de arriba, que es "Desktop app") y PUBLIC_BASE_URL
# con la URL pública del servidor.
GMAIL_WEB_CLIENT_ID=
GMAIL_WEB_CLIENT_SECRET=
PUBLIC_BASE_URL=
PORT=3000

# Interfaz donde escucha el servidor HTTP (dashboard en /dashboard + callback
# OAuth). Por defecto solo loopback: el dashboard muestra todas tus finanzas y
# no debe quedar abierto en internet. En la VPS se entra por túnel SSH:
#   ssh -L 3000:127.0.0.1:3000 usuario@vps  ->  http://localhost:3000/dashboard
# Usar 0.0.0.0 solo detrás de un proxy con login, o si otros usuarios deben
# alcanzar /oauth/callback.
HOST=127.0.0.1
# Otros nombres de Host aceptados por el dashboard (separados por comas), p. ej.
# el nombre de Tailscale de la VPS. localhost y 127.0.0.1 siempre valen.
DASHBOARD_ALLOWED_HOSTS=

# Polling de gastos nuevos (npm run poll)
POLL_INTERVAL_MINUTES=10
